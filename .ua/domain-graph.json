        "entities": [
          "CKLine_Combiner",
          "CKLine",
          "CBi",
          "CBiList",
          "CBiConfig",
          "CCombine_Item"
        ],
        "businessRules": [
          "向上趋势中，包含处理取高高点和高低点；向下趋势取低低点和高低点",
          "笔必须由顶分形和底分形交替连接，不可同向相连",
          "笔的跨度必须满足最小合并 K 线数量要求",
          "虚拟笔用于处理未确认的端点，在确认后替换为实际笔"
        ],
        "crossDomainInteractions": [
          "接收来自 数据接入与配置 的标准化 K 线数据",
