      "complexity": "complex"
    },
    {
      "id": "file:Chan.py",
      "type": "file",
      "name": "Chan.py",
      "filePath": "Chan.py",
      "summary": "缠论主入口类CChan，门面模式封装多级别K线加载、递归计算流水线（笔、段、中枢、买卖点）及序列化，支持批量与步进两种运行模式。",
      "tags": ["entry-point", "facade", "core", "serialization", "pipeline"],
      "complexity": "complex",
      "languageNotes": "使用__deepcopy__手动重建跨级别K线指针图，chan_dump_pickle在序列化前调整sys.setrecursionlimit避免递归溢出。"
    },
