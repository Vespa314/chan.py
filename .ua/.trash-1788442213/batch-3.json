    {
      "id": "file:KLine/KLine_Unit.py",
      "type": "file",
      "name": "KLine_Unit.py",
      "filePath": "KLine/KLine_Unit.py",
      "summary": "缠论K线单元核心数据结构，封装单根K线的所有属性（OHLCV、时间、指标），管理多级别父子K线关系，支持深拷贝、指标计算和DeMark引擎集成。",
      "tags": ["data-model", "core", "entry-point"],
      "complexity": "complex",
      "languageNotes": "深拷贝时手动处理指标对象和父子引用，避免递归溢出；支持多级别K线包含关系判断（include_sub_lv_time）。"
    },
